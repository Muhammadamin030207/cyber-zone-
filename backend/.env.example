# ============================
# Cyber-ZONE Backend (.env.example)
# Barcha secretlar faqat environment'da saqlanadi — bu faylga yozilmaydi.
# Bu fayl — HAQIQI env kontrakti: Render blueprint (render.yaml) va CI shu
# ro'yxatga asoslangan. Quyidagi qiymatlar — FAQAT namuna, hech qanday
# haqiqiy kalit/parol bu yerda yo'q (kalitlarni .env yoki Render dashboard'ga
# qo'ying, git'ga EMAS).
# ============================

# ---------- MUHIT ----------
NODE_ENV=development            # production (Render) / development (lokal)
PORT=5000

# ---------- DATABASE ----------
# Render Postgres'da blueprint avtomatik to'ldiradi (fromDatabase).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/cyber_zone?schema=public"

# Migratsiya qachon bajariladi:
#   production'da `prisma migrate deploy` avval preDeployCommand'da (Render),
#   keyin — agar SKIP_MIGRATE_ON_BOOT bo'lmasa — server boot'ida ham.
#   Render blueprint: preDeployCommand ISHLATADI -> shuning uchun
#   SKIP_MIGRATE_ON_BOOT=true (migratsiya IKKALA marta ishga tushmasin).
#   ESDA: bo'sh bo'lmagan HAR QANDAY qiymat ("true", "1", hatto "false")
#   migratsiyani o'chiradi — server.ts faqat mavjudligini tekshiradi.
SKIP_MIGRATE_ON_BOOT=true

# ---------- REDIS ----------
# Kesh, rate limit va WebAuthn challenge store uchun.
# Bo'sh qoldirilsa: rate limit process xotirasiga (single-instance),
# WebAuthn challenge berilmaydi (fail closed) — multi-instance uchun MAJBURIY.
REDIS_URL="redis://localhost:6380"

# ---------- JWT ----------
JWT_SECRET="change-this-super-secret-key-min-32-chars"
JWT_REFRESH_SECRET="change-this-refresh-secret-key-min-32-chars"
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# ---------- 2FA (TOTP) ----------
# twoFactorSecret bazada AES-256-GCM bilan SHIFRLANGAN holda saqlanadi
# (format: ct1:<base64 iv+tag+ciphertext>). Bu kalit o'sha kalitdan
# hosil qilinadi — MAJBURIY, kamida 32 ta tasodifiy belgi.
#   openssl rand -base64 32
# O'zgartirilsa — DB'dagi barcha shifrlangan 2FA secret'lari buziladi
# (foydalanuvchilar 2FA ni qayta o'rnatishi kerak bo'ladi). O'zgartirmang!
# Render blueprint'da `generateValue: true` bilan avtomatik yaratiladi.
TOTP_AT_REST_KEY=""

# ---------- CORS / FRONTEND ----------
# Vergul bilan bir nechta domain (CORS va WebAuthn expectedOrigin shu ro'yxatdan).
FRONTEND_URLS="http://localhost:3006, http://localhost:3000"
# FRONTEND_URL="http://localhost:3006"   # FRONTEND_URLS bo'lmasa fallback

# ---------- GOOGLE OAUTH ----------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# HAZIRDA ISHLATILMAYDI (faqat clientId tekshiriladi) — config'da o'qiladi,
# o'chirish uchun config/index.ts ni ham tahrirlash kerak.
GOOGLE_CLIENT_SECRET=""

# ---------- SUPER_ADMIN (seed) ----------
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-strong-password"
SUPER_ADMIN_NAME="Super Admin"

# ---------- EMAIL (Nodemailer / SMTP) ----------
# Gmail uchun oddiy Gmail paroli ISHLAMAYDI — App Password oling:
#   https://myaccount.google.com/apppasswords  (2FA yoqilgan bo'lishi kerak)
# Render free web service 25/465/587 portlarini bloklaydi. Brevo relay ishlatilsa
# 2525-portga o'ting (STARTTLS) yoki fallback bering — asosiy port ulanmasa sinaladi:
EMAIL_HOST=""                   # masalan: smtp-relay.brevo.com (Brevo) / smtp.gmail.com
EMAIL_PORT=2525
EMAIL_USE_TLS="false"            # 465-port uchun "true"; 587-da STARTTLS ishlatiladi
EMAIL_SECURE=""                  # ixtiyoriy alias (EMAIL_USE_TLS bilan bir xil)
EMAIL_FALLBACK_PORTS="2525"      # vergul bilan ketma-ket sinaladigan portlar
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="16-belgili-app-password"     # REAL SECRET — .env da, git'da EMAS
DEFAULT_FROM_EMAIL="Cyber-ZONE <no-reply@yourdomain.com>"
# EMAIL_TEST_TO="sizning@email.com"       # faqat test-mail skripti uchun

# ---------- TO'LOVLAR (PAYMENTS) ----------
# PAYMENTS_MODE="test"            # production -> real provayderlar, TEST yopiladi
# Sandbox (faqat lokal/dev uchun; production'da faqat "force" bilan):
#   PAYMENTS_DEV_MODE=1|true|force
PAYMENTS_DEV_MODE=""
PAYMENTS_DEV_MOCK_KEY="change-me-mock-key"   # sandbox mock gateway kaliti
MIN_DEPOSIT_PERCENT=10            # depozit minimal foizi (biznes qoida — foydalanuvchi bu chegaradan pastga tushsa olmaydi)
# STANDART DEPOZIT (avans) FOIZI — hech qayerda kodda hardcode emas.
# Bron yaratilganda shu qiymat `bookings.depositPercent` ga YOZILADI va
# keyingi to'lov talabi aynan shundan hisoblanadi.
# Masalan: total 120000 -> DEPOSIT_PERCENT=30 => avans 36000, qoldiq 84000.
DEPOSIT_PERCENT=30
# Callback/webhook bazaviy URL — "localhost"ga tushmasligi uchun LIVE host:
PROVIDER_CALLBACK_URL="https://cyberzone-backend-api.onrender.com"
# --- Click ---
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_MERCHANT_USER_ID=""
CLICK_SECRET_KEY=""
CLICK_CHECKOUT_URL="https://my.click.uz/services/pay"
# --- Payme ---
PAYME_MERCHANT_ID=""
PAYME_MERCHANT_KEY=""
PAYME_API_ENDPOINT="https://checkout.payme.uz"
PAYME_CHECKOUT_URL="https://checkout.payme.uz"
# --- Uzum ---
UZUM_MERCHANT_ID=""               # eski nomi: UZUM_TERMINAL_ID
UZUM_SECRET_KEY=""                # eski nomi: UZUM_API_KEY
UZUM_API_ENDPOINT="https://checkoutapi.uzumbank.uz"
UZUM_CHECKOUT_URL="https://www.uzumcheckout.uz"
# --- Paynet ---
PAYNET_MERCHANT_ID=""             # eski nomi: PAYNET_USERNAME
PAYNET_PASSWORD=""
PAYNET_SERVICE_ID=""
PAYNET_API_ENDPOINT="https://api.paynet.uz/api"
PAYNET_CHECKOUT_URL="https://app.paynet.uz"

# ---------- BIRON QOIDALARI ----------
# Muddati o'tgan to'lanmagan bron avtomatik bekor qilinadigan vaqt (daqiqa)
UNPAID_BOOKING_TTL_MINUTES=60
# Vaqtinchalik parol (xodim/SUPER_ADMIN) muddati, daqiqa
TEMP_PASSWORD_MINUTES=30

# ---------- LOGIN XAVFSIZLIGI (individual, hisob bo'yicha) ----------
LOGIN_MAX_ATTEMPTS=10             # 10-chi xatodan keyin hisob bloklanadi
LOGIN_LOCK_MINUTES="1440"         # bosqichlar: 60,120,300,1440 (soat)

# ---------- WEBAUTHN / PASSKEY ----------
# WEBAUTHN_RP_ID — passkey bog'langan FRONTEND domeni (backend emas!)
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Cyber-ZONE"
WEBAUTHN_EXPECTED_ORIGINS="http://localhost:3006,http://localhost:3000"

# ---------- AI ----------
# Gemini (asosiy). Kalit serverda qoladi, frontendga chiqmaydi.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
# Anthropic/Claude — kalit o'rnatilsa, Claude ustun hisoblanadi
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
ANTHROPIC_ENDPOINT="https://api.anthropic.com"

# ---------- TESTLAR (faqat lokal, CI da ishlatilmaydi) ----------
# E2E_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/cyber_zone_e2e?schema=public"
