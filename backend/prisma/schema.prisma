// Cyber-ZONE Database Schema
// Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ZoneType {
  GENERAL_HALL
  VIP
  CABIN
}

enum ComputerStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  BROKEN
}

enum BookingStatus {
  PENDING          // kutilmoqda (depozit to'lov kutilmoqda)
  PENDING_PAYMENT  // to'lov jarayonida (to'lov sessiyasi yaratildi, hali tasdiqlanmagan)
  PARTIALLY_PAID   // depozit to'langan, qoldiq qoldiqda (deposit < 100%)
  PAID             // to'liq to'langan (depozit = 100%)
  CONFIRMED        // tasdiqlangan (to'lov muvaffaqiyatli → slot band)
  ACTIVE           // foydalanuvchi xonada
  COMPLETED        // tugatilgan
  CANCELLED        // bekor qilingan
}

enum PaymentType {
  ADVANCE        // oldindan (depozit)
  REMAINING      // qoldiq
}

enum PaymentMethod {
  PAYME
  CLICK
  UZCARD
  HUMO
  UZUM
  PAYNET
  CASH
}

enum PaymentProvider {
  PAYME
  CLICK
  UZUM
  PAYNET
}

enum PaymentStatus {
  CREATED           // to'lov rekordi yaratildi
  PENDING           // kutilmoqda (eski/kompat)
  REDIRECT_REQUIRED // provider checkout'ga yo'naltirish kerak
  PROCESSING        // provayder tomonidan tasdiqlanmoqda
  PAID              // muvaffaqiyatli tasdiqlangan (provider verified)
  COMPLETED         // yakunlangan (CASH / kompat)
  FAILED            // muvaffaqiyatsiz
  CANCELLED         // bekor qilingan
  EXPIRED           // muddati o'tgan
  REFUNDED          // qaytarilgan
}

enum PromoUsageScope {
  SINGLE_USE    // promo-kod butun platformada faqat 1 marta ishlatilishi mumkin
  USER_LIMITED  // kod har bir foydalanuvchiga 1 marta (platformada cheksiz)
  MULTI_USE     // cheklovsiz (har bir user baribir faqat 1 marta — unique constraint)
}

enum BarItemCategory {
  DRINK
  FOOD
  DESSERT
}

enum BarOrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum NewsType {
  NEWS
  PROMOTION
  BANNER
}

// ===================== MODELS =====================

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?      @map("password_hash")
  googleId     String?      @unique @map("google_id")
  fullName     String       @map("full_name")
  phone        String?
  avatarUrl    String?      @map("avatar_url")
  role                 Role                 @default(USER)
  language             String               @default("uz") // uz | ru | en
  status               UserStatus           @default(ACTIVE)
loyaltyBalance Int @default(0) @map("loyalty_balance") // bonus ballar (1 ball = 1 so'm)

  resetToken           String?   @unique @map("reset_token")
  resetTokenExpiresAt  DateTime? @map("reset_token_expires_at")
  // VaQTINCHALIK PAROL (forgot-password): hash saqlanadi, plain text hech qachon DB'da yo'q
  tempPasswordHash      String?  @map("temp_password_hash")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  // Login bilan: parolni majburiy yangilash (vaqtinchalik parol bilan kirilganda)
  mustChangePassword Boolean @default(false) @map("must_change_password")

  // WebAuthn/Passkey: platform Face ID / fingerprint / security key
  requirePasskey Boolean @default(false) @map("require_passkey") // server-enforced "verify with passkey" policy

  // Brute-force himoyasi: ketma-ket xato urinishlar va vaqtincha bloklash
  failedLoginAttempts  Int      @default(0) @map("failed_login_attempts")
  loginLockStage       Int      @default(0) @map("login_lock_stage") // blok bosqichi (spec §4.2: doimiy 24h)
  loginLockedUntil     DateTime? @map("login_locked_until")

  // Server-side session invalidation: har bir JWT shu versiyani olib yuradi.
  // Logout / parol o'zgartirishda oshiriladi — eski tokenlar darhol kuchsizlanadi.
  tokenVersion Int @default(0) @map("token_version")

  // TOTP (RFC 6238) ikki faktorli autentifikatsiya. Secret faqat 2FA yoqilganda
  // saqlanadi; `twoFactorConfirmedAt` — setup tugallanganini bildiradi.
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorConfirmedAt DateTime? @map("two_factor_confirmed_at")
  // Bir martalik tiklash kodlari (bcrypt hash'lar massivi, JSON)
  twoFactorBackupCodes Json?     @map("two_factor_backup_codes")

  // "Yangi qurilma" aniqlash uchun oxirgi muvaffaqiyatli login ma'lumotlari
  lastLoginAt        DateTime? @map("last_login_at")
  lastLoginIp        String?   @map("last_login_ip")
  lastLoginUserAgent String?   @map("last_login_user_agent")

  securityEvents SecurityEvent[]

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  computerRoom ComputerRoom? // admin egalik qiladi
  bookings     Booking[]
  payments     Payment[]
  news         News[]
  reviews      Review[]
  notifications Notification[]
  promoCodes   PromoCode[]
  barOrders    BarOrder[]
  chatMessages ChatMessage[]
  passkeys     Passkey[]
  conversations AIConversation[]
  promoRedemptions PromoRedemption[]
  supportThread SupportMessage[] @relation("SupportThread")
  supportSent   SupportMessage[] @relation("SupportSender")
  loyaltyTransactions LoyaltyTransaction[]

  @@map("users")
}

// ============ XAVFSIZLIK VOQEALARI (AUDIT) ============
// Har bir muhim xavfsizlik hodisasi (login, lockout, parol o'zgarishi, 2FA,
// passkey va boshqalar) shu yerda qat'iy qayd etiladi — Security Center va audit
// uchun. Faqat append-only jadval; hech narsa o'chirilmaydi/tahrirlanmaydi.
model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // LOGIN_SUCCESS | LOGIN_FAILED | LOGIN_LOCKED | LOGIN_UNLOCKED |
  // PASSWORD_CHANGED | PASSWORD_RESET | TWOFA_ENABLED | TWOFA_DISABLED |
  // TWOFA_RECOVERY_USED | PASSKEY_ADDED | PASSKEY_REMOVED | LOGOUT | SESSION_REVOKED
  type      String   @map("type")
  ip        String?  @map("ip")
  userAgent String?  @map("user_agent")
  metadata  Json?    @map("metadata")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

model ComputerRoom {
  id           String       @id @default(uuid())
  ownerId      String       @unique @map("owner_id")
  name         String
  description  String?
  address      String
  district     String?      // Toshkent tumani, masalan: "Mirzo Ulug'bek"
  city         String       @default("Toshkent")
  latitude     Float?
  longitude    Float?
  phone        String?
  workingHours Json?        @map("working_hours") // { open: "09:00", close: "23:00" }
  timezone     String       @default("Asia/Tashkent")
  images       Json?        // massiv [url1, url2]
  status       RoomStatus   @default(PENDING)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  owner        User         @relation(fields: [ownerId], references: [id])
  zones        Zone[]
  bookings     Booking[]
  news         News[]
  reviews      Review[]
  promoCodes   PromoCode[]
  barItems     BarItem[]
  barOrders    BarOrder[]
  chatMessages ChatMessage[]
  supportMessages SupportMessage[]

  @@map("computer_rooms")
}

model Zone {
  id           String    @id @default(uuid())
  roomId       String    @map("room_id")
  type         ZoneType
  name         String
  description  String?
  capacity     Int        @default(0)
  pricePerHour Decimal    @map("price_per_hour") @db.Decimal(10, 2)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  room        ComputerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  computers   Computer[]
  bookings    Booking[]

  @@map("zones")
}

model Computer {
  id        String          @id @default(uuid())
  zoneId    String          @map("zone_id")
  name      String
  specs     Json            // { cpu, gpu, ram, monitor, storage, peripherals }
  status    ComputerStatus  @default(AVAILABLE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  zone     Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("computers")
}

model Booking {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  roomId           String        @map("room_id")
  zoneId           String        @map("zone_id")
  computerId       String?       @map("computer_id")
  promoCodeId      String?       @map("promo_code_id")
  date             DateTime      @db.Date
  startTime        String        @map("start_time") // "14:00"
  endTime          String        @map("end_time")   // "17:00"
  durationHours    Decimal       @map("duration_hours") @db.Decimal(4, 1)
  totalPrice       Decimal       @map("total_price") @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalPrice       Decimal       @map("final_price") @db.Decimal(10, 2)
  pointsUsed       Int           @default(0) @map("points_used") // bonus ballar bilan to'lagan summa (so'm)
  advanceAmount    Decimal       @map("advance_amount") @db.Decimal(10, 2) // depozit summa
  remainingAmount  Decimal       @map("remaining_amount") @db.Decimal(10, 2) // qoldiq
  depositPercent   Int           @default(30) @map("deposit_percent") // foydalanuvchi tanlagan depozit foizi
  status           BookingStatus @default(PENDING)
  notes            String?
  idempotencyKey   String?       @map("idempotency_key") // takroriy so'rovlardan himoya (user bo'yicha unique)

  // SESSIYA (check-in / check-out) — §2.5 real foydalanish hisobi.
  // Bron ACTIVE bo'lganda sessionStartedAt server tomonidan yoziladi; check-out'da
  // haqiqiy o'yin vaqti va narx hisoblanadi (min 1 soat billing, ortig'i/refund ballga).
  sessionStartedAt     DateTime? @map("session_started_at")
  sessionEndedAt       DateTime? @map("session_ended_at")
  actualDurationMinutes Int?     @map("actual_duration_minutes") // haqiqiy o'yin daqiqalari
  actualPrice          Decimal?  @map("actual_price") @db.Decimal(10, 2) // haqiqiy sessiya narxi (so'm)
  billingAdjustment    Decimal?  @map("billing_adjustment") @db.Decimal(10, 2) // 0 yoki musbat: qo'shimcha to'lov; manfiy: qaytarilgan
  minBillingMinutes    Int       @default(60) @map("min_billing_minutes") // minimal hisoblanadigan vaqt (1 soat)

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id])
  room     ComputerRoom  @relation(fields: [roomId], references: [id])
  zone     Zone          @relation(fields: [zoneId], references: [id])
  computer Computer?     @relation(fields: [computerId], references: [id])
  promoCode PromoCode?   @relation(fields: [promoCodeId], references: [id])
  redemption PromoRedemption?
  payments Payment[]
  barOrder BarOrder?

  @@unique([userId, idempotencyKey])
  @@index([roomId, date], map: "bookings_room_id_date_idx")
  @@index([computerId, date], map: "bookings_computer_id_date_idx")
  @@index([userId, createdAt], map: "bookings_user_id_created_at_idx")
  @@index([status, createdAt], map: "bookings_status_created_at_idx")
  @@map("bookings")
}

model PromoCode {
  id                String    @id @default(uuid())
  roomId            String?   @map("room_id")
  code              String    @unique
  discountType      String    @map("discount_type") // PERCENTAGE | FIXED
  discountValue     Decimal   @map("discount_value") @db.Decimal(10, 2)
  minBookingAmount  Decimal?  @map("min_booking_amount") @db.Decimal(10, 2)
  usageScope        PromoUsageScope @default(SINGLE_USE) @map("usage_scope")
  maxUses           Int?      @map("max_uses")
  usedCount         Int       @default(0) @map("used_count")
  // Har bir foydalanuvchi necha marta ishlatishi mumkin (1|2|N). PromoRedemption
  // qatorlari hisobiga tekshiriladi (identity: userId + bir xil telefon twin'lari).
  usageLimitPerUser Int       @default(1) @map("usage_limit_per_user")
  // SHAXSIY promo-kod: aniq foydalanuvchiga beriladi (identifikatsiya: userId /
  // tasdiqlangan telefon / email — IP EMAS). Faqat mos shaxs ishlata oladi.
  isPersonal        Boolean   @default(false) @map("is_personal")
  recipientUserId   String?   @map("recipient_user_id")
  recipientPhone    String?   @map("recipient_phone")
  recipientEmail    String?   @map("recipient_email")
  startsAt          DateTime  @map("starts_at")
  expiresAt         DateTime  @map("expires_at")
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  room      ComputerRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator   User          @relation(fields: [createdBy], references: [id])
  bookings  Booking[]
  redemptions PromoRedemption[]

  @@map("promo_codes")
}

// ============ PROMO-KOD QO'LLANISHLARI ============
// Har bir muvaffaqiyatli promo qo'llanish alohida qayd etiladi.
// (promoCodeId, userId) bo'yicha indeks — har bir foydalanuvchi necha marta
// ishlatganini sanash va identity tekshiruvlarini tezlashtirish uchun.
// Bitta kod bitta foydalanuvchiga faqat usageLimitPerUser marta: bu chegara
// ENDI DB unique-emas, server kodi (advisory lock + hisob) orqali kafolatlanadi —
// konfiguratsiyalanuvchi (1|2|N) bo'lishi uchun.
model PromoRedemption {
  id          String   @id @default(uuid())
  promoCodeId String   @map("promo_code_id")
  userId      String   @map("user_id")
  bookingId   String   @unique @map("booking_id")
  createdAt   DateTime @default(now()) @map("created_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, userId])
  @@index([userId])
  @@index([bookingId])
  @@map("promo_redemptions")
}

model Payment {
  id                   String            @id @default(uuid())
  bookingId            String            @map("booking_id")
  userId               String            @map("user_id")
  amount               Decimal           @db.Decimal(10, 2)
  type                 PaymentType
  method               PaymentMethod?
  provider             PaymentProvider?  @map("provider")
  status               PaymentStatus     @map("status")
  currency             String            @default("UZS")
  depositPercent       Int               @default(30) @map("deposit_percent")
  providerTransactionId String?          @unique @map("provider_transaction_id") // idempotency (provider transaction ID)
  providerPaymentId    String?           @map("provider_payment_id")
  transactionId        String?           @map("transaction_id") // eski/kompat
  idempotencyKey       String?           @unique @map("idempotency_key") // client so'rovi kaliti — takroriy yaratishni DB darajasida to'xtatadi
  metadata             Json?             @map("metadata")
  failureReason        String?           @map("failure_reason")
  expiresAt            DateTime?         @map("expires_at")
  paidAt               DateTime?         @map("paid_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at")

  booking Booking       @relation(fields: [bookingId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  audits  PaymentAuditLog[]

  @@index([bookingId, status], map: "payments_booking_id_status_idx")
  @@index([userId, createdAt], map: "payments_user_id_created_at_idx")
  @@index([status, expiresAt], map: "payments_status_expires_at_idx")
  @@map("payments")
}

// ============ TO'LOV AUDIT LOGI ============
// Har bir to'lov voqeasi xavfsizlik va qarorlar uchun qatori.
model PaymentAuditLog {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  action     String   @map("action") // payment_created | redirect_generated | webhook_received | payment_verified | payment_failed | booking_confirmed | refund_requested | refund_completed | admin_marked_paid
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  metadata   Json?    @map("metadata")
  createdAt  DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([action])
  @@map("payment_audit_logs")
}

// ============ BAR (Gaming kafe) ============
model BarItem {
  id          String            @id @default(uuid())
  roomId      String            @map("room_id")
  name        String
  description String?
  price       Decimal           @db.Decimal(10, 2)
  category    BarItemCategory   @default(DRINK)
  imageUrl    String?           @map("image_url")
  isAvailable Boolean           @default(true) @map("is_available")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  room ComputerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("bar_items")
}

model BarOrder {
  id          String          @id @default(uuid())
  roomId      String          @map("room_id")
  bookingId   String?         @unique @map("booking_id")
  userId      String          @map("user_id")
  seatNumber  String?         @map("seat_number") // kompyuter yoki stol raqami
  items       Json            // [{ itemId, name, price, qty }]
  totalPrice  Decimal         @map("total_price") @db.Decimal(10, 2)
  status      BarOrderStatus  @default(PENDING)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  room    ComputerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  booking Booking?     @relation(fields: [bookingId], references: [id])
  user    User         @relation(fields: [userId], references: [id])

  @@map("bar_orders")
}

// ============ JONLI SUHBAT (Chat) ============
model ChatMessage {
  id         String   @id @default(uuid())
  roomId     String   @map("room_id")
  userId     String   @map("user_id") // yuboruvchi (USER yoki ADMIN/SUPER_ADMIN)
  role       String   @default("USER") // USER | ADMIN | SUPER_ADMIN
  message    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  room ComputerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@map("chat_messages")
}

// ===================== SUPPORT / MUROJAATLAR =====================
// recipientRole: kanalni aniqlaydi
//   - 'SUPER_ADMIN' -> foydalanuvchi/admin super_admin'ga yozadi (thread userId bo'yicha)
//   - 'ADMIN'       -> foydalanuvchi xona adminiga yozadi (thread userId + roomId bo'yicha)
model SupportMessage {
  id            String   @id @default(cuid())
  userId        String   @map("user_id") // murojaat qilgan foydalanuvchi (thread egasi)
  senderId      String?  @map("sender_id") // yuboruvchi (admin/super_admin javobi yoki nol)
  message       String
  recipientRole String   @default("SUPER_ADMIN") @map("recipient_role") // ADMIN | SUPER_ADMIN
  roomId        String?  @map("room_id") // ADMIN kanali uchun xona (thread = userId + roomId)
  isRead        Boolean   @default(false) @map("is_read")
  createdAt     DateTime  @default(now()) @map("created_at")
  editedAt      DateTime? @map("edited_at") // xabar tahrirlangan sanasi (agar tahrirlangan bo'lsa)

  user   User  @relation("SupportThread", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SupportSender", fields: [senderId], references: [id])
  room   ComputerRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([senderId])
  @@index([recipientRole])
  @@index([roomId])
  @@map("support_messages")
}

model News {
  id          String    @id @default(uuid())
  roomId      String?   @map("room_id")
  authorId    String    @map("author_id")
  title       String
  content     String
  imageUrl    String?   @map("image_url")
  type        NewsType  @default(NEWS)
  isActive    Boolean   @default(true) @map("is_active")
  publishedAt DateTime  @default(now()) @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  room   ComputerRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id])

  @@map("news")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roomId    String   @map("room_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User         @relation(fields: [userId], references: [id])
  room ComputerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ============ LOYALTY (Bonus ballar) ============
model LoyaltyTransaction {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  type         String    // EARN | REDEEM | REFUND
  amount       Int       // + ball qo'shildi / - ball sarflandi
  balanceAfter Int       @map("balance_after")
  description  String
  bookingId    String?   @map("booking_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookingId])
  @@map("loyalty_transactions")
}

// ============ WEBAUTHN / PASSKEY (Face ID, fingerprint, security key) ============
// Server-da credential metadatasi saqlanadi. Privpat key HECH QACHON serverga
// yuborilmaydi — WebAuthn attestation/assertion signature orqali ishlaydi.
model Passkey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  // WebAuthn credential ID (base64url) — unique
  credentialId String   @unique @map("credential_id")
  // Credential public key (Buffer) — private key serverda YO'Q
  publicKey    Bytes    @map("public_key")
  counter      BigInt   @default(0) @map("counter") // replay himoyasi
  // Authenticator transports (usb, internal, nfc, ble) — JSON nusxasi
  transports   Json?
  deviceName   String   @default("") @map("device_name") // user tomonidan nomlanadi
  // Qaysi AAGUID (authenticator modeli) — platforma, might be empty
  aaguid       String?  @default("") @map("aaguid")
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// ============ AI SUHBATLAR (conversations / messages) ============
model AIConversation {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  title     String      @default("Yangi suhbat") @map("title")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  role           String        // user | assistant | system
  content        String
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ============ SAYT BILIMLARI (admin boshqaradigan) ============
// AI yordamchisi faqat shu yerdan o'qigan FAQ/aloqa/to'lov/bekor qilish ma'lumotlarini
// ishlatadi (§6.16 — hardcoded kontekst YO'Q). Faqat ADMIN/SUPER_ADMIN yozadi.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique // faqat ALLOWED_KEYS ruxsat etiladi
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // qaysi admin yangilagan

  @@map("site_settings")
}